meta {
  name: Token - Authorization Code + PKCE
  type: http
  seq: 3
}

# -------------------------------------------------------
# Krok 1: wygeneruj code_challenge w terminalu:
#   echo -n "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk" \
#     | openssl dgst -binary -sha256 | base64 | tr '+/' '-_' | tr -d '='
#
# Krok 2: otwórz w przeglądarce URL poniżej (zastąp CODE_CHALLENGE wynikiem):
#   http://localhost:9000/oauth2/authorize
#     ?response_type=code
#     &client_id=demo-client
#     &redirect_uri=http://localhost:9000/callback
#     &scope=openid
#     &code_challenge=<CODE_CHALLENGE>
#     &code_challenge_method=S256
#
# Zaloguj się (admin/nimda), skopiuj parametr ?code=... z redirect URL.
# Krok 3: wklej kod w polu "code" poniżej i wyślij request.
# -------------------------------------------------------

post {
  url: {{base_url}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{client_id}}
  password: {{client_secret}}
}

body:form-urlencoded {
  grant_type: authorization_code
  code: WKLEJ_KOD_TUTAJ
  redirect_uri: http://localhost:9000/callback
  code_verifier: {{code_verifier}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.access_token);
  }
}
